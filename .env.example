# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=axon_dev
NEO4J_DATABASE=neo4j

# API
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=true
API_SECRET_KEY=change_me_in_production

# Logging
LOG_LEVEL=INFO

# Graph settings
GRAPH_STALENESS_THRESHOLD_SECONDS=300

# v2 store: memory (dev/tests, no DB needed) | neo4j
AXON_STORE=memory

# Ask model: none | local | external
# local/external call an OpenAI-compatible endpoint, e.g. a local
# `vllm serve <hf-model-id>` at http://localhost:8000, or any external URL.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
