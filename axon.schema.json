{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "axon.yaml service map",
  "type": "object",
  "properties": {
    "version": {"type": "integer"},
    "repo": {"type": "string"},
    "extends": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "overrides": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}, {"type": "object"}]},
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "roots": {"$ref": "#/$defs/stringList"},
          "language": {"type": "string"},
          "framework": {"type": "string"},
          "specs": {"$ref": "#/$defs/stringList"},
          "base_urls": {"$ref": "#/$defs/stringList"},
          "clients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": {"type": "string"},
                "packages": {"$ref": "#/$defs/stringList"},
                "paths": {"$ref": "#/$defs/stringList"},
                "factories": {"$ref": "#/$defs/stringList"},
                "target_service": {"type": "string"},
                "target_repo": {"type": "string"},
                "base_urls": {"$ref": "#/$defs/stringList"},
                "spec": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "shared": {"$ref": "#/$defs/stringList"},
    "ignore": {"$ref": "#/$defs/stringList"},
    "index": {
      "type": "object",
      "properties": {
        "include_unowned": {"type": "boolean"},
        "exclude_tests": {"type": "boolean"}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to_service", "to_path"],
        "properties": {
          "call_name": {"type": "string"},
          "url_contains": {"type": "string"},
          "to_service": {"type": "string"},
          "to_method": {"type": "string"},
          "to_path": {"type": "string"},
          "to_repo": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "oneOf": [
        {"type": "array", "items": {"type": "string"}},
        {"type": "object", "required": ["+append"], "additionalProperties": false,
         "properties": {"+append": {"type": "array", "items": {"type": "string"}}}}
      ]
    }
  }
}
