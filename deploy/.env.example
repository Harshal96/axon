# Axon deployment settings. setup.sh copies this to .env and fills in
# generated secrets; for a manual install: cp .env.example .env, then
# replace every change-me value below.

# Image tag to run (a release like 0.2.0, or latest to track main).
AXON_VERSION=latest

# Required. Used by Neo4j and the API. Changing it later means also
# changing the password inside the existing neo4j_data volume.
NEO4J_PASSWORD=change-me-generate-a-long-random-password

# Host ports. Neo4j ports are bound to 127.0.0.1 in the compose file.
AXON_API_PORT=8080
AXON_WEB_PORT=8081
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Host directory whose checkouts the server can index, mounted read-only
# at /repos. Default: ./repos next to the compose file.
AXON_REPOS_DIR=./repos

# Optional API auth: none (default) | dev. With dev, every API call needs
# "Authorization: Bearer $API_DEV_TOKEN" (CLI: set AXON_API_TOKEN).
# The web UI cannot send a token yet, so dev mode is CLI/MCP-only.
# Axon is local-first: on an untrusted network, put the stack behind a
# VPN or an authenticated TLS reverse proxy either way.
API_AUTH_MODE=none
API_DEV_TOKEN=change-me-generate-a-long-random-token

# Ask model: none | local | external (OpenAI-compatible endpoint).
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Fallback generative endpoint (used only when the primary is
# unreachable, times out, is rate-limited, or returns 5xx):
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# Comma-separated model IDs allowed at either position (empty = any):
LLM_ALLOWED_MODELS=

# Neo4j sizing. Large monorepos need more heap, e.g. 4g.
# AXON_NEO4J_HEAP_MAX=2g
# AXON_NEO4J_PAGECACHE=1g
# AXON_NEO4J_TX_MAX=1g
